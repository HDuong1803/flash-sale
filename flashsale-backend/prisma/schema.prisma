// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  engineType    = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid()) @map("id") @db.VarChar(36)
  email         String     @unique @map("email") @db.VarChar(255)
  emailVerified Boolean?   @default(false) @map("email_verified")
  passwordHash  String?    @map("password_hash") @db.VarChar(255)
  role          UserRole   @default(CUSTOMER) @map("role")
  status        UserStatus @default(ACTIVE) @map("status")
  fullName      String     @map("full_name") @db.VarChar(255)
  avatarId      String?    @unique @map("avatar_id") @db.VarChar(36)
  lastLoginAt   DateTime?  @map("last_login_at") @db.Timestamp(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)

  photo              Photo?                      @relation("AvatarImage", fields: [avatarId], references: [id])
  merchantProfile    MerchantProfile?
  customerProfile    CustomerProfile?
  preRegistrations   PreRegistration[]
  reservations       Reservation[]
  orders             Order[]
  notifications      Notification[]
  notificationPreference NotificationPreference?
  telegramLink       TelegramLink?
  telegramDeliveries TelegramDelivery[]
  rescheduleRequests CampaignRescheduleRequest[] @relation("RescheduleRequests")

  @@map("users")
}

model Photo {
  id           String   @id @unique @map("id") @db.VarChar(36)
  url          String   @map("url") @db.Text
  fileEntityId String   @unique @map("file_entity_id") @db.VarChar(36)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  file          FileEntity?    @relation(fields: [fileEntityId], references: [id])
  user          User?          @relation("AvatarImage")
  productImages ProductImage[] @relation("ProductPhotoImages")

  @@map("photo")
}

model FileEntity {
  id           String   @id @unique @map("id") @db.VarChar(36)
  userUploadId String?  @map("user_upload_id") @db.VarChar(36)
  fileName     String   @map("file_name") @db.VarChar(255)
  path         String?  @map("path") @db.VarChar(255)
  key          String?  @map("key") @db.VarChar(255)
  url          String?  @map("url") @db.Text
  uploadHash   String?  @map("upload_hash") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(255)
  size         Int      @map("size")
  description  String   @map("description") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  Photo Photo[]

  @@map("file_entities")
}

model MerchantProfile {
  id              String    @id @default(cuid()) @map("id") @db.VarChar(36)
  userId          String    @unique @map("user_id") @db.VarChar(36)
  businessName    String    @map("business_name") @db.VarChar(255)
  taxCode         String    @unique @map("tax_code") @db.VarChar(255)
  description     String?   @map("description") @db.Text
  phone           String?   @map("phone") @db.VarChar(20)
  address         String?   @map("address") @db.Text
  kycStatus       KycStatus @default(PENDING) @map("kyc_status")
  rejectionReason String?   @map("rejection_reason") @db.Text
  approvedAt      DateTime? @map("approved_at") @db.Timestamp(6)
  approvedBy      String?   @map("approved_by") @db.VarChar(36)

  // Stripe Connect (Destination Charges model)
  stripeAccountId      String?   @map("stripe_account_id") @db.VarChar(255)
  stripeAccountStatus  String    @default("NOT_CONNECTED") @map("stripe_account_status") @db.VarChar(50)
  stripeChargesEnabled Boolean   @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled Boolean   @default(false) @map("stripe_payouts_enabled")
  stripeConnectedAt    DateTime? @map("stripe_connected_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns         Campaign[]
  orders            Order[]
  products          Product[]
  commissionLedgers CommissionLedger[]

  @@index([kycStatus])
  @@index([stripeAccountId])
  @@index([stripeAccountStatus])
  @@map("merchant_profiles")
}

model CustomerProfile {
  id             String   @id @default(cuid()) @map("id") @db.VarChar(36)
  userId         String   @unique @map("user_id") @db.VarChar(36)
  phone          String?  @map("phone") @db.VarChar(20)
  defaultAddress String?  @map("default_address") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model Product {
  id            String        @id @default(cuid()) @map("id") @db.VarChar(36)
  merchantId    String        @map("merchant_id") @db.VarChar(36)
  name          String        @map("name") @db.VarChar(255)
  description   String?       @map("description") @db.Text
  category      String?       @map("category") @db.VarChar(255) // Phân loại sản phẩm (optional, chưa normalize)
  originalPrice Decimal       @map("original_price") @db.Decimal(12, 2)
  status        ProductStatus @default(ACTIVE) @map("status")
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamp(6) // Soft delete — merchant deactivate hoặc xóa
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)

  merchant         MerchantProfile   @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  inventory        Inventory[]
  campaignProducts CampaignProduct[]
  orderItems       OrderItem[]
  stockAuditLogs   StockAuditLog[]

  @@index([merchantId])
  @@index([status, deletedAt]) // Query sản phẩm đang active, chưa bị xóa
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid()) @map("id") @db.VarChar(36)
  productId String  @map("product_id") @db.VarChar(36)
  photoId   String  @unique @map("photo_id") @db.VarChar(36)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  photo   Photo   @relation("ProductPhotoImages", fields: [photoId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model Inventory {
  id          String   @id @default(cuid()) @map("id") @db.VarChar(36)
  productId   String   @map("product_id") @db.VarChar(36)
  warehouseId String   @default("default") @map("warehouse_id") @db.VarChar(36)
  quantity    Int      @default(0) @map("quantity")
  reserved    Int      @default(0) @map("reserved") // Số lượng đang được giữ chỗ bởi các reservation HOLDING
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([productId])
  @@map("inventory")
}

model Campaign {
  id              String         @id @default(cuid()) @map("id") @db.VarChar(36)
  merchantId      String         @map("merchant_id") @db.VarChar(36)
  name            String         @map("name") @db.VarChar(255)
  description     String?        @map("description") @db.Text
  startTime       DateTime       @map("start_time") @db.Timestamp(6)
  endTime         DateTime       @map("end_time") @db.Timestamp(6)
  status          CampaignStatus @default(DRAFT) @map("status")
  rejectionReason String?        @map("rejection_reason") @db.Text // Admin ghi lý do từ chối, merchant xem được
  commissionCategoryId String?   @map("commission_category_id") @db.VarChar(36)
  commissionRate    Decimal      @default(0) @map("commission_rate") @db.Decimal(5, 4) // Snapshot % hoa hồng tại thời điểm tạo campaign
  approvedAt      DateTime?      @map("approved_at") @db.Timestamp(6) // Thời điểm được admin duyệt
  approvedBy      String?        @map("approved_by") @db.VarChar(36) // ID của admin đã duyệt (audit trail)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamp(6) // Soft delete — admin xóa campaign vi phạm
  merchantHiddenAt DateTime?     @map("merchant_hidden_at") @db.Timestamp(6) // Merchant tự ẩn campaign đã hết hạn khỏi danh sách của mình
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamp(6)

  merchant             MerchantProfile             @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  commissionCategory   CommissionCategory?         @relation(fields: [commissionCategoryId], references: [id], onDelete: SetNull)
  campaignProducts     CampaignProduct[]
  preRegistrations     PreRegistration[]
  rescheduleRequests   CampaignRescheduleRequest[]
  commissionLedgers    CommissionLedger[]

  @@index([status, startTime])
  @@index([merchantId])
  @@index([commissionCategoryId])
  @@index([startTime]) // Scheduler query campaigns sắp bắt đầu
  @@index([endTime]) // Scheduler query WHERE endTime <= NOW() để đóng campaign
  @@map("campaigns")
}

model CampaignProduct {
  id                String   @id @default(cuid()) @map("id") @db.VarChar(36)
  campaignId        String   @map("campaign_id") @db.VarChar(36)
  productId         String   @map("product_id") @db.VarChar(36)
  salePrice         Decimal  @map("sale_price") @db.Decimal(12, 2)
  saleQuantity      Int      @map("sale_quantity") // Tổng số lượng được bán trong campaign
  perUserLimit      Int      @default(1) @map("per_user_limit")
  // remainingQuantity được quản lý bằng Redis Lua script (atomic DECR).
  // Giá trị trong DB chỉ dùng để khởi tạo và đồng bộ lại sau campaign.
  // KHÔNG dùng DB để check còn hàng — luôn dùng Redis.
  remainingQuantity Int      @map("remaining_quantity")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  reservations     Reservation[]
  stockAllocations StockAllocation[]
  pricingRules     PricingRule[]
  priceHistory     PriceHistory[]

  @@unique([campaignId, productId])
  @@index([campaignId])
  @@index([campaignId, remainingQuantity]) // Worker check còn hàng không — avoid full scan
  @@map("campaign_products")
}

model PreRegistration {
  id           String   @id @default(cuid()) @map("id") @db.VarChar(36)
  customerId   String   @map("customer_id") @db.VarChar(36)
  campaignId   String   @map("campaign_id") @db.VarChar(36)
  registeredAt DateTime @default(now()) @map("registered_at") @db.Timestamp(6)
  reminderSent Boolean  @default(false) @map("reminder_sent") // Đã gửi reminder email trước giờ mở bán chưa

  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([customerId, campaignId])
  @@index([campaignId])
  @@map("pre_registrations")
}

model CampaignRescheduleRequest {
  id           String                  @id @default(cuid()) @map("id") @db.VarChar(36)
  campaignId   String                  @map("campaign_id") @db.VarChar(36)
  requestedBy  String                  @map("requested_by") @db.VarChar(36)
  requestType  RescheduleRequestType   @map("request_type")
  newStartTime DateTime                @map("new_start_time") @db.Timestamp(6)
  status       RescheduleRequestStatus @default(PENDING_MERCHANT) @map("status")
  expiresAt    DateTime                @map("expires_at") @db.Timestamp(6)
  note         String?                 @db.Text
  resolvedAt   DateTime?               @map("resolved_at") @db.Timestamp(6)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamp(6)

  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  requestedByUser User     @relation("RescheduleRequests", fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([campaignId, status])
  @@index([requestType, status])
  @@map("campaign_reschedule_requests")
}

model Reservation {
  id                String            @id @default(cuid()) @map("id") @db.VarChar(36)
  customerId        String            @map("customer_id") @db.VarChar(36)
  campaignProductId String            @map("campaign_product_id") @db.VarChar(36)
  quantity          Int               @map("quantity")
  status            ReservationStatus @default(HOLDING) @map("status")
  statusReason      String?           @map("status_reason") @db.Text
  statusHistory     Json?             @map("status_history") // Array of {status, reason, timestamp} — trace mọi transition
  idempotencyKey    String            @unique @map("idempotency_key") @db.VarChar(255) // Key = userId:campaignProductId — 1 user chỉ giữ 1 slot
  shippingAddress   String?           @map("shipping_address") @db.Text // Checkout lưu vào đây — Saga đọc ra để tạo Order, không cần Redis workaround
  expiredAt         DateTime          @map("expired_at") @db.Timestamp(6) // Worker đặt TTL; scheduler cleanup reservation HOLDING quá hạn
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamp(6)

  customer        User            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  campaignProduct CampaignProduct @relation(fields: [campaignProductId], references: [id], onDelete: Restrict)
  order           Order?
  payment         Payment?
  stockAllocations StockAllocation[]

  @@index([status, expiredAt]) // Scheduler cleanup HOLDING đã hết hạn
  @@index([customerId, campaignProductId])
  @@index([customerId, campaignProductId, status])
  @@index([campaignProductId, status]) // Worker query còn slot không
  @@map("reservations")
}

model Order {
  id              String      @id @default(cuid()) @map("id") @db.VarChar(36)
  customerId      String      @map("customer_id") @db.VarChar(36)
  merchantId      String      @map("merchant_id") @db.VarChar(36)
  reservationId   String      @unique @map("reservation_id") @db.VarChar(36)
  idempotencyKey  String      @unique @map("idempotency_key") @db.VarChar(255) // = requestId từ purchase flow — worker retry không tạo duplicate
  status          OrderStatus @default(PENDING) @map("status")
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)
  shippingAddress String      @map("shipping_address") @db.Text // Copy từ Reservation.shippingAddress lúc tạo Order
  cancelledAt     DateTime?   @map("cancelled_at") @db.Timestamp(6) // Thời điểm hủy đơn
  cancelReason    String?     @map("cancel_reason") @db.Text // Lý do hủy — merchant hoặc customer điền
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamp(6) // Soft delete — audit + rollback
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamp(6)

  customer    User            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  merchant    MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  reservation Reservation     @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  payment     Payment?
  commissionLedger CommissionLedger?

  @@index([customerId, createdAt(sort: Desc)])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([status]) // Admin filter orders by status
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(cuid()) @map("id") @db.VarChar(36)
  orderId       String   @map("order_id") @db.VarChar(36)
  productId     String   @map("product_id") @db.VarChar(36)
  quantity      Int      @map("quantity")
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2) // Giá bán tại thời điểm mua (= salePrice)
  originalPrice Decimal  @map("original_price") @db.Decimal(12, 2) // Giá gốc tại thời điểm mua — dùng tính discount history
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model Payment {
  id             String        @id @default(cuid()) @map("id") @db.VarChar(36)
  reservationId  String        @unique @map("reservation_id") @db.VarChar(36) // FK chính — Payment tạo ngay lúc Checkout, trước khi Order tồn tại
  orderId        String?       @unique @map("order_id") @db.VarChar(36) // Nullable — được set sau khi Order được tạo bởi Worker
  amount         Decimal       @map("amount") @db.Decimal(12, 2)
  method         PaymentMethod @map("method")
  status         PaymentStatus @default(PENDING) @map("status")
  transactionId  String?       @unique @map("transaction_id") @db.VarChar(255) // ID transaction từ payment gateway (VNPay/Momo/Stripe)
  idempotencyKey String        @unique @map("idempotency_key") @db.VarChar(255) // Chống duplicate payment
  failureReason  String?       @map("failure_reason") @db.Text // Lý do thất bại từ gateway — dùng để debug và retry
  paidAt         DateTime?     @map("paid_at") @db.Timestamp(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamp(6) // Soft delete — audit trail
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)

  reservation  Reservation        @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  order        Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  webhookLogs  PaymentWebhookLog[]
  commissionLedgers CommissionLedger[]

  @@index([idempotencyKey])
  @@index([transactionId])
  @@index([status]) // Admin báo cáo payment failed
  @@index([reservationId, status]) // Worker lookup payment của reservation
  @@map("payments")
}

model PaymentGatewayConfig {
  id          String        @id @default(cuid()) @map("id") @db.VarChar(36)
  gateway     PaymentMethod @unique @map("gateway")
  displayName String        @map("display_name") @db.VarChar(100)
  enabled     Boolean       @default(false) @map("enabled")
  isDefault   Boolean       @default(false) @map("is_default")
  config      Json?         @map("config")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([enabled, isDefault])
  @@map("payment_gateway_configs")
}

model CommissionCategory {
  id          String   @id @default(cuid()) @map("id") @db.VarChar(36)
  code        String   @unique @map("code") @db.VarChar(50)
  name        String   @map("name") @db.VarChar(150)
  description String?  @map("description") @db.Text
  defaultRate Decimal  @map("default_rate") @db.Decimal(5, 4) // Ví dụ 0.0850 = 8.5%
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  campaigns         Campaign[]
  commissionLedgers CommissionLedger[]

  @@index([isActive, sortOrder])
  @@map("commission_categories")
}

model CommissionLedger {
  id                   String   @id @default(cuid()) @map("id") @db.VarChar(36)
  orderId              String   @unique @map("order_id") @db.VarChar(36)
  paymentId            String?  @map("payment_id") @db.VarChar(36)
  campaignId           String   @map("campaign_id") @db.VarChar(36)
  merchantId           String   @map("merchant_id") @db.VarChar(36)
  commissionCategoryId String?  @map("commission_category_id") @db.VarChar(36)
  commissionRate       Decimal  @map("commission_rate") @db.Decimal(5, 4) // Snapshot tại thời điểm order
  grossAmount          Decimal  @map("gross_amount") @db.Decimal(12, 2)
  commissionAmount     Decimal  @map("commission_amount") @db.Decimal(12, 2)
  netAmount            Decimal  @map("net_amount") @db.Decimal(12, 2)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment            Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  campaign           Campaign            @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  merchant           MerchantProfile     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  commissionCategory CommissionCategory? @relation(fields: [commissionCategoryId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt(sort: Desc)])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([commissionCategoryId])
  @@index([createdAt(sort: Desc)])
  @@map("commission_ledgers")
}

model StockAuditLog {
  id              String        @id @default(cuid()) @map("id") @db.VarChar(36)
  productId       String        @map("product_id") @db.VarChar(36)
  delta           Int           @map("delta") // Số lượng thay đổi (âm = giảm, dương = tăng)
  stockBefore     Int           @map("stock_before")
  stockAfter      Int           @map("stock_after")
  reason          String        @map("reason") @db.VarChar(255)
  referenceId     String?       @map("reference_id") @db.VarChar(36)
  triggeredBy     String?       @map("triggered_by") @db.VarChar(50)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(6)

  // Benchmark & audit fields (Hướng 1)
  isOversell      Boolean       @default(false) @map("is_oversell")
  strategy        LockStrategy  @default(REDIS_LUA) @map("strategy")
  executionTimeUs Int           @default(0) @map("execution_time_us") // microseconds

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt(sort: Desc)])
  @@index([referenceId])
  @@index([createdAt(sort: Desc)])
  @@index([isOversell, createdAt(sort: Desc)]) // Fast query for oversell events
  @@map("stock_audit_logs")
}

model Notification {
  id        String           @id @default(cuid()) @map("id") @db.VarChar(36)
  userId    String           @map("user_id") @db.VarChar(36)
  type      NotificationType @map("type")
  title     String           @map("title") @db.VarChar(255)
  message   String           @map("message") @db.Text
  read      Boolean          @default(false) @map("read")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamp(6)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramDeliveries TelegramDelivery[]

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)]) // Feed notification theo thời gian
  @@map("notifications")
}

model NotificationPreference {
  id                       String   @id @default(cuid()) @map("id") @db.VarChar(36)
  userId                   String   @unique @map("user_id") @db.VarChar(36)
  notificationsEnabled     Boolean  @default(true) @map("notifications_enabled")
  campaignReminderEnabled  Boolean  @default(true) @map("campaign_reminder_enabled")
  orderStatusEnabled       Boolean  @default(true) @map("order_status_enabled")
  telegramEnabled          Boolean  @default(false) @map("telegram_enabled")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model TelegramLink {
  id                String    @id @default(cuid()) @map("id") @db.VarChar(36)
  userId            String    @unique @map("user_id") @db.VarChar(36)
  telegramChatId    String    @map("telegram_chat_id") @db.VarChar(255)
  telegramUserId    String    @map("telegram_user_id") @db.VarChar(255)
  telegramUsername  String?   @map("telegram_username") @db.VarChar(255)
  telegramFirstName String?   @map("telegram_first_name") @db.VarChar(255)
  telegramLastName  String?   @map("telegram_last_name") @db.VarChar(255)
  linkedAt          DateTime  @default(now()) @map("linked_at") @db.Timestamp(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamp(6)
  lastInteractionAt DateTime? @map("last_interaction_at") @db.Timestamp(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([telegramChatId])
  @@index([telegramUserId])
  @@index([revokedAt])
  @@map("telegram_links")
}

model TelegramDelivery {
  id                String                 @id @default(cuid()) @map("id") @db.VarChar(36)
  userId            String                 @map("user_id") @db.VarChar(36)
  notificationId    String?                @map("notification_id") @db.VarChar(36)
  eventType         NotificationType       @map("event_type")
  idempotencyKey    String                 @unique @map("idempotency_key") @db.VarChar(120)
  status            TelegramDeliveryStatus @default(PENDING) @map("status")
  attemptCount      Int                    @default(0) @map("attempt_count")
  providerMessageId String?                @map("provider_message_id") @db.VarChar(120)
  errorCode         String?                @map("error_code") @db.VarChar(120)
  errorMessage      String?                @map("error_message") @db.Text
  sentAt            DateTime?              @map("sent_at") @db.Timestamp(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamp(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification  Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([notificationId])
  @@map("telegram_deliveries")
}

model DeadLetterJob {
  id            String    @id @default(cuid()) @map("id") @db.VarChar(36)
  type          String    @map("type") @db.VarChar(100) // Loại job (ví dụ: "order.process", "notification.send")
  originalQueue String    @map("original_queue") @db.VarChar(100) // Queue gốc mà job đến từ — dùng để retry đúng queue
  errorMessage  String    @map("error_message") @db.Text
  payload       Json      @map("payload")
  retryCount    Int       @default(0) @map("retry_count")
  lastRetryAt   DateTime? @map("last_retry_at") @db.Timestamp(6) // Thời điểm retry gần nhất
  failedAt      DateTime  @default(now()) @map("failed_at") @db.Timestamp(6)

  @@index([type]) // Filter theo loại job để retry hàng loạt
  @@index([failedAt(sort: Desc)]) // Admin xem jobs thất bại gần nhất
  @@map("dead_letter_jobs")
}

// StockAllocation — event-sourcing lite cho flash sale stock
// Mỗi reservation tạo 1 record → rebuild stock từ đây nếu Redis lệch state
model StockAllocation {
  id                String   @id @default(cuid()) @map("id") @db.VarChar(36)
  campaignProductId String   @map("campaign_product_id") @db.VarChar(36)
  reservationId     String   @map("reservation_id") @db.VarChar(36)
  quantity          Int      @map("quantity")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  campaignProduct CampaignProduct @relation(fields: [campaignProductId], references: [id], onDelete: Restrict)
  reservation     Reservation     @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([campaignProductId, reservationId]) // 1 reservation chỉ allocate 1 lần cho mỗi product
  @@index([campaignProductId])
  @@map("stock_allocations")
}

// PaymentWebhookLog — bắt buộc cho production: dedup gateway retry, lưu raw payload
model PaymentWebhookLog {
  id            String   @id @default(cuid()) @map("id") @db.VarChar(36)
  paymentId     String?  @map("payment_id") @db.VarChar(36) // Nullable — có thể webhook đến trước Payment record
  provider      String   @map("provider") @db.VarChar(50) // "vnpay" | "momo" | "stripe"
  transactionId String?  @map("transaction_id") @db.VarChar(255)
  payload       Json     @map("payload") // Raw payload từ gateway — không bao giờ drop
  processed     Boolean  @default(false) @map("processed") // false = chưa xử lý hoặc xử lý lỗi
  processedAt   DateTime? @map("processed_at") @db.Timestamp(6)
  errorMessage  String?  @map("error_message") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([transactionId]) // Dedup check trước khi xử lý
  @@index([processed, createdAt]) // Worker pickup unprocessed logs
  @@map("payment_webhook_logs")
}

// UserActionLog — anti-abuse: detect spam click, block IP, audit trail
model UserActionLog {
  id        String   @id @default(cuid()) @map("id") @db.VarChar(36)
  userId    String?  @map("user_id") @db.VarChar(36) // Nullable — guest request
  ip        String?  @map("ip") @db.VarChar(45) // IPv6 max = 45 chars
  action    String   @map("action") @db.VarChar(50) // "reserve" | "checkout" | "purchase"
  targetId  String?  @map("target_id") @db.VarChar(36) // campaignProductId hoặc campaignId
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([ip, action, createdAt]) // Rate limit check theo IP + action trong time window
  @@index([userId, action, createdAt]) // Rate limit check theo user
  @@map("user_action_logs")
}

// OutboxEvent — transactional outbox pattern: đảm bảo event luôn được gửi sau DB write
// Dùng cho: notification, analytics sync, external webhook
model OutboxEvent {
  id          String   @id @default(cuid()) @map("id") @db.VarChar(36)
  type        String   @map("type") @db.VarChar(100) // "order.created" | "payment.succeeded" | "reservation.expired"
  aggregateId String   @map("aggregate_id") @db.VarChar(36) // ID của entity gốc (orderId, reservationId...)
  payload     Json     @map("payload")
  processed   Boolean  @default(false) @map("processed")
  processedAt DateTime? @map("processed_at") @db.Timestamp(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([processed, createdAt]) // Outbox worker poll — chỉ quét unprocessed, sort by time
  @@index([type, aggregateId]) // Dedup check: tránh emit cùng event 2 lần cho cùng entity
  @@map("outbox_events")
}

// ─── Innovation Models ────────────────────────────────────────────────────────

// FraudEvent — ghi mọi request được đánh giá rủi ro (Hướng 3)
model FraudEvent {
  id             String   @id @default(cuid()) @map("id") @db.VarChar(36)
  userId         String?  @map("user_id") @db.VarChar(36)
  ipAddress      String   @map("ip_address") @db.VarChar(45)
  userAgent      String   @map("user_agent") @db.Text
  requestType    String   @map("request_type") @db.VarChar(50)
  riskScore      Float    @map("risk_score")
  blocked        Boolean  @default(false) @map("blocked")
  blockReason    String?  @map("block_reason") @db.VarChar(100)
  triggeredRules Json     @map("triggered_rules")
  signals        Json     @map("signals")
  campaignId     String?  @map("campaign_id") @db.VarChar(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
  @@index([blocked, createdAt])
  @@map("fraud_events")
}

// IpBlacklist — danh sách IP bị chặn vĩnh viễn hoặc tạm thời (Hướng 3)
model IpBlacklist {
  id        String    @id @default(cuid()) @map("id") @db.VarChar(36)
  ipAddress String    @unique @map("ip_address") @db.VarChar(45)
  reason    String    @map("reason") @db.VarChar(255)
  expiresAt DateTime? @map("expires_at") @db.Timestamp(6)
  createdBy String    @map("created_by") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("ip_blacklists")
}

// UserRiskProfile — hồ sơ rủi ro tổng hợp theo userId (Hướng 3)
model UserRiskProfile {
  userId        String   @id @map("user_id") @db.VarChar(36)
  riskScore     Float    @default(0.0) @map("risk_score")
  totalAttempts Int      @default(0) @map("total_attempts")
  blockedCount  Int      @default(0) @map("blocked_count")
  notes         String?  @map("notes") @db.Text
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("user_risk_profiles")
}

// PricingRule — cấu hình luật định giá động do merchant thiết lập (Hướng 4)
model PricingRule {
  id                String          @id @default(cuid()) @map("id") @db.VarChar(36)
  campaignProductId String          @map("campaign_product_id") @db.VarChar(36)
  name              String          @map("name") @db.VarChar(100)
  strategy          PricingStrategy @map("strategy")
  priority          Int             @default(0) @map("priority")
  isActive          Boolean         @default(true) @map("is_active")

  // STOCK_BASED
  stockRatioLow  Float? @map("stock_ratio_low")
  stockRatioHigh Float? @map("stock_ratio_high")
  stockAction    PriceAction? @map("stock_action")

  // VELOCITY_BASED
  velocityMin    Float? @map("velocity_min")
  velocityMax    Float? @map("velocity_max")
  velocityAction PriceAction? @map("velocity_action")

  // TIME_BASED
  minutesBeforeEnd Int? @map("minutes_before_end")
  timeAction       PriceAction? @map("time_action")

  // Adjustment & guardrails
  adjustmentPct Float @map("adjustment_pct")
  minPrice      Float @map("min_price")
  maxPrice      Float @map("max_price")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  campaignProduct CampaignProduct @relation(fields: [campaignProductId], references: [id], onDelete: Cascade)
  priceHistory    PriceHistory[]

  @@index([campaignProductId, isActive])
  @@map("pricing_rules")
}

// PriceHistory — lịch sử thay đổi giá để vẽ chart (Hướng 4)
model PriceHistory {
  id                String   @id @default(cuid()) @map("id") @db.VarChar(36)
  campaignProductId String   @map("campaign_product_id") @db.VarChar(36)
  ruleId            String?  @map("rule_id") @db.VarChar(36)
  oldPrice          Float    @map("old_price")
  newPrice          Float    @map("new_price")
  changePct         Float    @map("change_pct")
  reason            String   @map("reason") @db.VarChar(100)
  triggeredBy       String   @default("SYSTEM") @map("triggered_by") @db.VarChar(50)
  stockAtChange     Int      @map("stock_at_change")
  velocityAtChange  Float    @map("velocity_at_change")
  timeRemainingMin  Int      @map("time_remaining_min")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  campaignProduct CampaignProduct @relation(fields: [campaignProductId], references: [id], onDelete: Cascade)
  rule            PricingRule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([campaignProductId, createdAt])
  @@map("price_history")
}

// CampaignAnalyticsSnapshot — time-series snapshot mỗi 5 phút (Hướng 5)
model CampaignAnalyticsSnapshot {
  id                String   @id @default(cuid()) @map("id") @db.VarChar(36)
  campaignId        String   @map("campaign_id") @db.VarChar(36)
  campaignProductId String   @map("campaign_product_id") @db.VarChar(36)
  snapshotAt        DateTime @default(now()) @map("snapshot_at") @db.Timestamp(6)
  stockRemaining    Int      @map("stock_remaining")
  stockTotal        Int      @map("stock_total")
  stockRatio        Float    @map("stock_ratio")
  purchaseCount     Int      @map("purchase_count")
  revenue           Float    @map("revenue")
  conversionRate    Float    @default(0) @map("conversion_rate")
  viewCount         Int      @default(0) @map("view_count")
  clickCount        Int      @default(0) @map("click_count")
  attemptCount      Int      @default(0) @map("attempt_count")
  purchasesLast5m   Int      @default(0) @map("purchases_last_5m")
  revenueVelocity   Float    @default(0) @map("revenue_velocity")

  @@index([campaignId, snapshotAt])
  @@index([campaignProductId, snapshotAt])
  @@map("campaign_analytics_snapshots")
}

// FunnelEvent — theo dõi từng bước trong funnel mua hàng (Hướng 5)
model FunnelEvent {
  id         String     @id @default(cuid()) @map("id") @db.VarChar(36)
  sessionId  String     @map("session_id") @db.VarChar(100)
  userId     String?    @map("user_id") @db.VarChar(36)
  campaignId String     @map("campaign_id") @db.VarChar(36)
  step       FunnelStep @map("step")
  metadata   Json?      @map("metadata")
  ipAddress  String?    @map("ip_address") @db.VarChar(45)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([campaignId, step, createdAt])
  @@index([sessionId])
  @@map("funnel_events")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  MERCHANT
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum KycStatus {
  PENDING // Đang chờ admin duyệt
  APPROVED // Đã được duyệt
  REJECTED // Bị từ chối
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum CampaignStatus {
  DRAFT // Merchant tạo, chưa gửi duyệt
  APPROVED // Admin đã duyệt
  SCHEDULED // Đã duyệt, chưa đến giờ bắt đầu
  ACTIVE // Đang diễn ra
  ENDED // Kết thúc
}

enum ReservationStatus {
  HOLDING   // Đang giữ chỗ, chờ thanh toán
  PAID      // Đã thanh toán thành công
  EXPIRED   // Hết hạn giữ chỗ — scheduler tự cleanup
  CANCELLED // User chủ động hủy hoặc merchant hủy campaign
  FAILED    // Lỗi hệ thống — payment failed, worker crash
}

enum OrderStatus {
  PENDING // Vừa tạo, chờ xử lý
  CONFIRMED // Đã xác nhận
  SHIPPING // Đang giao hàng
  DONE // Giao hàng thành công
  CANCELLED // Đã hủy
}

enum PaymentMethod {
  STRIPE
}

enum PaymentStatus {
  PENDING // Chờ người dùng thanh toán
  PROCESSING // Đang xử lý thanh toán với gateway
  SUCCESS // Thanh toán thành công
  FAILED // Thanh toán thất bại
  REFUNDED // Đã hoàn tiền
  CANCELLED // Thanh toán bị hủy (ví dụ: user hủy trong quá trình thanh toán)
}

enum NotificationType {
  RESERVATION_EXPIRING // Nhắc nhở reservation sắp hết hạn
  ORDER_CONFIRMED // Đơn hàng được xác nhận
  PAYMENT_FAILED // Thanh toán thất bại
  CAMPAIGN_STARTING // Flash sale sắp bắt đầu
  CAMPAIGN_RESCHEDULED // Thời gian bắt đầu chiến dịch đã thay đổi
  RESCHEDULE_CONFIRMATION_NEEDED // Merchant cần xác nhận yêu cầu thay đổi lịch
  SYSTEM_ALERT // Cảnh báo vận hành/hệ thống cho admin
}

enum TelegramDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum RescheduleRequestType {
  ADMIN_FORCE // Admin khởi tạo, merchant phải xác nhận
  MERCHANT_REQUEST // Merchant khởi tạo, admin phải duyệt
}

enum RescheduleRequestStatus {
  PENDING_MERCHANT // Admin force: chờ merchant xác nhận
  PENDING_ADMIN // Merchant request: chờ admin duyệt
  APPLIED // Đã áp dụng — startTime campaign đã được cập nhật
  REJECTED // Bị từ chối
  EXPIRED // Hết hạn
}

enum LockStrategy {
  NO_LOCK    // Không có lock — dễ bị race condition / oversell
  DB_LOCK    // PostgreSQL SELECT FOR UPDATE — an toàn nhưng chậm
  REDIS_LUA  // Redis Lua atomic script — production standard
}

enum PricingStrategy {
  STOCK_BASED    // Điều chỉnh theo tỉ lệ tồn kho
  VELOCITY_BASED // Điều chỉnh theo tốc độ mua
  TIME_BASED     // Điều chỉnh theo thời gian còn lại
  COMPOSITE      // Kết hợp nhiều signals
}

enum PriceAction {
  INCREASE
  DECREASE
}

enum FunnelStep {
  CAMPAIGN_VIEW      // User xem trang campaign
  PRODUCT_CLICK      // User click vào sản phẩm
  PURCHASE_ATTEMPT   // User click nút mua
  CHECKOUT_OPEN      // User mở trang checkout
  PAYMENT_INITIATED  // User chọn phương thức thanh toán
  PAYMENT_SUCCESS    // Thanh toán thành công
  PAYMENT_FAILED     // Thanh toán thất bại
}
