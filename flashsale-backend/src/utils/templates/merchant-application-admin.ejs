<%- include('_header', { title: 'Đơn đăng ký Merchant mới — Flash Sale', preheader: 'Có một đơn đăng ký Merchant mới cần xét duyệt từ ' + merchantName }) %>

<!-- Heading -->
<p style="margin:0 0 6px 0;font-size:22px;font-weight:700;color:#111827;line-height:1.3;">Đơn đăng ký Merchant mới</p>
<p style="margin:0 0 28px 0;font-size:15px;color:#6B7280;line-height:1.6;">
  Hệ thống vừa tiếp nhận một đơn đăng ký trở thành Merchant trên nền tảng <strong style="color:#DC2626;">Flash Sale</strong>. Vui lòng xem xét và xét duyệt đơn này.
</p>

<!-- Divider -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;">
  <tr><td style="border-top:1px solid #E5E7EB;"></td></tr>
</table>

<!-- Icon -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:24px;">
  <tr>
    <td align="center">
      <table role="presentation" cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td style="background-color:#FEF2F2;border-radius:50%;width:56px;height:56px;text-align:center;vertical-align:middle;">
            <span style="font-size:28px;line-height:56px;">&#127981;</span>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- Merchant info card -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;border:1px solid #E5E7EB;border-radius:12px;overflow:hidden;">
  <tr>
    <td style="background-color:#F9FAFB;padding:14px 20px;border-bottom:1px solid #E5E7EB;">
      <p style="margin:0;font-size:12px;font-weight:700;color:#6B7280;text-transform:uppercase;letter-spacing:1px;">Thông tin đơn đăng ký</p>
    </td>
  </tr>
  <tr>
    <td style="padding:0;">
      <!-- Row: Merchant name -->
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <tr>
          <td style="padding:16px 20px;border-bottom:1px solid #F3F4F6;width:40%;vertical-align:top;">
            <p style="margin:0;font-size:13px;color:#6B7280;font-weight:500;">Tên doanh nghiệp</p>
          </td>
          <td style="padding:16px 20px;border-bottom:1px solid #F3F4F6;vertical-align:top;">
            <p style="margin:0;font-size:14px;font-weight:700;color:#111827;"><%= merchantName %></p>
          </td>
        </tr>
        <!-- Row: Applicant email -->
        <tr>
          <td style="padding:16px 20px;vertical-align:top;">
            <p style="margin:0;font-size:13px;color:#6B7280;font-weight:500;">Email người đăng ký</p>
          </td>
          <td style="padding:16px 20px;vertical-align:top;">
            <p style="margin:0;font-size:14px;font-weight:600;color:#DC2626;"><%= applicantEmail %></p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- CTA Button -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;">
  <tr>
    <td align="center">
      <table role="presentation" cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td align="center" style="border-radius:8px;background-color:#DC2626;">
            <a href="<%= adminUrl %>" style="display:inline-block;padding:14px 32px;color:#FFFFFF;font-size:15px;font-weight:600;text-decoration:none;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">Xét duyệt ngay &#8594;</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- Divider -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:24px;">
  <tr><td style="border-top:1px solid #E5E7EB;"></td></tr>
</table>

<!-- Note -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
  <tr>
    <td style="background-color:#F9FAFB;border-radius:8px;padding:14px 20px;">
      <p style="margin:0;font-size:13px;color:#6B7280;line-height:1.6;">
        Email này được gửi tự động từ hệ thống Flash Sale. Vui lòng không trả lời email này. Để quản lý đơn đăng ký, hãy truy cập bảng điều khiển quản trị.
      </p>
    </td>
  </tr>
</table>

<%- include('_footer') %>
