<%- include('_header', { title: 'Yêu cầu thay đổi lịch chiến dịch — Flash Sale', preheader: 'Admin yêu cầu thay đổi lịch bắt đầu chiến dịch ' + campaignName }) %>

<!-- Alert banner -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;">
  <tr>
    <td align="center" style="background:linear-gradient(135deg,#D97706 0%,#F59E0B 100%);border-radius:12px;padding:20px 24px;">
      <span style="font-size:32px;display:block;margin-bottom:8px;">&#9888;&#65039;</span>
      <p style="margin:0;font-size:18px;font-weight:700;color:#FFFFFF;line-height:1.3;">Yêu cầu xác nhận thay đổi lịch</p>
    </td>
  </tr>
</table>

<!-- Greeting -->
<p style="margin:0 0 8px 0;font-size:22px;font-weight:700;color:#111827;line-height:1.3;">Xin chào, <%= merchantName %>!</p>
<p style="margin:0 0 28px 0;font-size:15px;color:#6B7280;line-height:1.6;">
  Admin đã gửi yêu cầu thay đổi thời gian bắt đầu chiến dịch <strong style="color:#111827;"><%= campaignName %></strong>. Vui lòng xem xét và xác nhận hoặc từ chối yêu cầu này.
</p>

<!-- Divider -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;">
  <tr><td style="border-top:1px solid #E5E7EB;"></td></tr>
</table>

<!-- Info card -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;border:1px solid #E5E7EB;border-radius:12px;overflow:hidden;">
  <tr>
    <td style="background:linear-gradient(135deg,#D97706 0%,#F59E0B 100%);padding:14px 20px;">
      <p style="margin:0;font-size:12px;font-weight:700;color:#FFFFFF;text-transform:uppercase;letter-spacing:1px;">&#128197; Chi tiết yêu cầu</p>
    </td>
  </tr>
  <tr>
    <td style="padding:0;">
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <!-- Campaign name -->
        <tr>
          <td style="padding:16px 20px;border-bottom:1px solid #F3F4F6;width:45%;vertical-align:top;">
            <p style="margin:0;font-size:13px;color:#6B7280;font-weight:500;">Tên chiến dịch</p>
          </td>
          <td style="padding:16px 20px;border-bottom:1px solid #F3F4F6;vertical-align:top;">
            <p style="margin:0;font-size:14px;font-weight:700;color:#111827;"><%= campaignName %></p>
          </td>
        </tr>
        <!-- New start time -->
        <tr>
          <td style="padding:16px 20px;border-bottom:1px solid #F3F4F6;vertical-align:top;">
            <p style="margin:0;font-size:13px;color:#6B7280;font-weight:500;">Thời gian bắt đầu mới</p>
          </td>
          <td style="padding:16px 20px;border-bottom:1px solid #F3F4F6;vertical-align:top;">
            <p style="margin:0;font-size:14px;font-weight:700;color:#DC2626;"><%= newStartTime %></p>
          </td>
        </tr>
        <!-- Expires at -->
        <tr>
          <td style="padding:16px 20px;vertical-align:top;">
            <p style="margin:0;font-size:13px;color:#6B7280;font-weight:500;">Yêu cầu hết hạn lúc</p>
          </td>
          <td style="padding:16px 20px;vertical-align:top;">
            <p style="margin:0;font-size:14px;font-weight:600;color:#D97706;"><%= expiresAt %></p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- Warning callout -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;">
  <tr>
    <td style="background-color:#FFFBEB;border-radius:8px;padding:16px 20px;border-left:4px solid #F59E0B;">
      <p style="margin:0;font-size:14px;color:#92400E;line-height:1.6;">
        <strong>&#9201; Lưu ý:</strong> Yêu cầu này sẽ hết hạn vào <strong><%= expiresAt %></strong>. Nếu không phản hồi, yêu cầu sẽ tự động bị hủy và lịch chiến dịch sẽ không thay đổi.
      </p>
    </td>
  </tr>
</table>

<!-- CTA Button -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;">
  <tr>
    <td align="center">
      <a href="<%= dashboardUrl %>" style="display:inline-block;background-color:#DC2626;color:#FFFFFF;text-decoration:none;font-size:15px;font-weight:700;padding:14px 32px;border-radius:8px;letter-spacing:0.3px;">
        Xem và Xác nhận Yêu cầu
      </a>
    </td>
  </tr>
</table>

<!-- Security note -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:8px;">
  <tr>
    <td style="background-color:#F9FAFB;border-radius:8px;padding:14px 20px;">
      <p style="margin:0;font-size:13px;color:#6B7280;line-height:1.6;">
        &#128274; Nếu bạn không kỳ vọng nhận được email này hoặc có bất kỳ thắc mắc nào, vui lòng liên hệ với đội hỗ trợ Flash Sale. Đừng chia sẻ đường dẫn này với bất kỳ ai.
      </p>
    </td>
  </tr>
</table>

<%- include('_footer') %>
