<%- include('_header', { title: 'Đặt lại mật khẩu — Flash Sale', preheader: 'Mã OTP đặt lại mật khẩu Flash Sale của bạn là ' + otp }) %>

<!-- Greeting -->
<p style="margin:0 0 8px 0;font-size:22px;font-weight:700;color:#111827;line-height:1.3;">Xin chào, <%= name %>!</p>
<p style="margin:0 0 28px 0;font-size:15px;color:#6B7280;line-height:1.6;">
  Chúng tôi nhận được yêu cầu đặt lại mật khẩu cho tài khoản <strong style="color:#DC2626;">Flash Sale</strong> của bạn. Sử dụng mã OTP bên dưới để tiến hành đặt lại mật khẩu.
</p>

<!-- Divider -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;">
  <tr><td style="border-top:1px solid #E5E7EB;"></td></tr>
</table>

<!-- Icon + label -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:20px;">
  <tr>
    <td align="center">
      <table role="presentation" cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td style="background-color:#FFF7ED;border-radius:50%;width:56px;height:56px;text-align:center;vertical-align:middle;">
            <span style="font-size:28px;line-height:56px;">&#128272;</span>
          </td>
        </tr>
      </table>
      <p style="margin:12px 0 0 0;font-size:13px;font-weight:600;color:#F97316;text-transform:uppercase;letter-spacing:1px;">Mã đặt lại mật khẩu</p>
    </td>
  </tr>
</table>

<!-- OTP Box -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;">
  <tr>
    <td align="center">
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="border:2px solid #DC2626;border-radius:12px;background-color:#FEF2F2;">
        <tr>
          <td style="padding:20px 40px;">
            <span style="font-size:42px;font-weight:800;letter-spacing:12px;color:#DC2626;font-family:'Courier New',Courier,monospace;"><%= otp %></span>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- Expiry warning -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:20px;">
  <tr>
    <td style="background-color:#FFFBEB;border-radius:8px;padding:14px 20px;border-left:4px solid #F59E0B;">
      <p style="margin:0;font-size:14px;color:#92400E;line-height:1.5;">
        <strong>&#9203; Lưu ý:</strong> Mã OTP này sẽ hết hạn sau <strong><%= expiresInMinutes %> phút</strong>. Chỉ nhập mã này trên trang web chính thức của Flash Sale.
      </p>
    </td>
  </tr>
</table>

<!-- Divider -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:24px;">
  <tr><td style="border-top:1px solid #E5E7EB;"></td></tr>
</table>

<!-- Security note — amber/warning tone -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
  <tr>
    <td style="background-color:#FFF7ED;border-radius:8px;padding:16px 20px;border-left:4px solid #F97316;">
      <p style="margin:0;font-size:13px;color:#7C2D12;line-height:1.6;">
        <strong style="color:#9A3412;">&#9888; Không phải bạn yêu cầu?</strong> Nếu bạn không thực hiện yêu cầu này, hãy bỏ qua email này. Mật khẩu hiện tại của bạn vẫn không thay đổi và tài khoản hoàn toàn an toàn. Nếu bạn lo lắng, hãy liên hệ bộ phận hỗ trợ.
      </p>
    </td>
  </tr>
</table>

<%- include('_footer') %>
