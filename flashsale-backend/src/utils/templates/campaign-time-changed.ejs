<%- include('_header', { title: 'Thông báo thay đổi lịch chiến dịch — Flash Sale', preheader: 'Thời gian bắt đầu chiến dịch ' + campaignName + ' vừa được cập nhật' }) %>

<!-- Info banner -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;">
  <tr>
    <td align="center" style="background:linear-gradient(135deg,#2563EB 0%,#3B82F6 100%);border-radius:12px;padding:20px 24px;">
      <span style="font-size:32px;display:block;margin-bottom:8px;">&#128337;</span>
      <p style="margin:0;font-size:18px;font-weight:700;color:#FFFFFF;line-height:1.3;">Thời gian bắt đầu chiến dịch đã thay đổi</p>
    </td>
  </tr>
</table>

<!-- Greeting -->
<p style="margin:0 0 8px 0;font-size:22px;font-weight:700;color:#111827;line-height:1.3;">Xin chào, <%= name %>!</p>
<p style="margin:0 0 28px 0;font-size:15px;color:#6B7280;line-height:1.6;">
  Chiến dịch <strong style="color:#111827;"><%= campaignName %></strong> mà bạn đã đăng ký theo dõi vừa thay đổi thời gian bắt đầu. Vui lòng cập nhật lịch của bạn để không bỏ lỡ cơ hội mua sắm.
</p>

<!-- Divider -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;">
  <tr><td style="border-top:1px solid #E5E7EB;"></td></tr>
</table>

<!-- Time comparison card -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;border:1px solid #E5E7EB;border-radius:12px;overflow:hidden;">
  <tr>
    <td style="background:linear-gradient(135deg,#2563EB 0%,#3B82F6 100%);padding:14px 20px;">
      <p style="margin:0;font-size:12px;font-weight:700;color:#FFFFFF;text-transform:uppercase;letter-spacing:1px;">&#128197; Thay đổi lịch chiến dịch</p>
    </td>
  </tr>
  <tr>
    <td style="padding:0;">
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <!-- Campaign name -->
        <tr>
          <td style="padding:16px 20px;border-bottom:1px solid #F3F4F6;width:40%;vertical-align:top;">
            <p style="margin:0;font-size:13px;color:#6B7280;font-weight:500;">Tên chiến dịch</p>
          </td>
          <td style="padding:16px 20px;border-bottom:1px solid #F3F4F6;vertical-align:top;">
            <p style="margin:0;font-size:14px;font-weight:700;color:#111827;"><%= campaignName %></p>
          </td>
        </tr>
        <!-- Old start time -->
        <tr>
          <td style="padding:16px 20px;border-bottom:1px solid #F3F4F6;vertical-align:top;">
            <p style="margin:0;font-size:13px;color:#6B7280;font-weight:500;">Thời gian cũ</p>
          </td>
          <td style="padding:16px 20px;border-bottom:1px solid #F3F4F6;vertical-align:top;">
            <p style="margin:0;font-size:14px;color:#9CA3AF;text-decoration:line-through;"><%= oldStartTime %></p>
          </td>
        </tr>
        <!-- New start time -->
        <tr>
          <td style="padding:16px 20px;vertical-align:top;">
            <p style="margin:0;font-size:13px;color:#6B7280;font-weight:500;">Thời gian mới</p>
          </td>
          <td style="padding:16px 20px;vertical-align:top;">
            <p style="margin:0;font-size:14px;font-weight:700;color:#DC2626;"><%= newStartTime %> &nbsp;<span style="background-color:#FEF2F2;color:#DC2626;font-size:11px;font-weight:700;padding:2px 6px;border-radius:4px;text-transform:uppercase;letter-spacing:0.5px;">Mới</span></p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- Info callout -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;">
  <tr>
    <td style="background-color:#EFF6FF;border-radius:8px;padding:16px 20px;border-left:4px solid #3B82F6;">
      <p style="margin:0;font-size:14px;color:#1E40AF;line-height:1.6;">
        <strong>&#128276; Nhắc nhở tự động:</strong> Bạn đã đăng ký nhận thông báo cho chiến dịch này. Chúng tôi sẽ nhắc bạn trước khi chiến dịch bắt đầu theo thời gian mới.
      </p>
    </td>
  </tr>
</table>

<!-- Divider -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:24px;">
  <tr><td style="border-top:1px solid #E5E7EB;"></td></tr>
</table>

<!-- Footer note -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
  <tr>
    <td style="background-color:#F9FAFB;border-radius:8px;padding:14px 20px;">
      <p style="margin:0;font-size:13px;color:#6B7280;line-height:1.6;">
        Nếu bạn muốn hủy đăng ký nhận thông báo, bạn có thể thực hiện trong phần cài đặt tài khoản trên trang web Flash Sale.
      </p>
    </td>
  </tr>
</table>

<%- include('_footer') %>
