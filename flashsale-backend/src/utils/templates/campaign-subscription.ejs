<%- include('_header', { title: 'Đăng ký chiến dịch thành công — Flash Sale', preheader: 'Bạn đã đăng ký nhận thông báo cho chiến dịch ' + campaignName }) %>

<!-- Success banner -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;">
  <tr>
    <td align="center" style="background:linear-gradient(135deg,#059669 0%,#10B981 100%);border-radius:12px;padding:20px 24px;">
      <span style="font-size:32px;display:block;margin-bottom:8px;">&#9989;</span>
      <p style="margin:0;font-size:18px;font-weight:700;color:#FFFFFF;line-height:1.3;">Đăng ký thành công!</p>
    </td>
  </tr>
</table>

<!-- Greeting -->
<p style="margin:0 0 8px 0;font-size:22px;font-weight:700;color:#111827;line-height:1.3;">Xin chào, <%= name %>!</p>
<p style="margin:0 0 28px 0;font-size:15px;color:#6B7280;line-height:1.6;">
  Bạn đã đăng ký nhận thông báo cho chiến dịch trên <strong style="color:#DC2626;">Flash Sale</strong> thành công. Chúng tôi sẽ nhắc nhở bạn trước khi chiến dịch bắt đầu để bạn không bỏ lỡ cơ hội mua sắm hấp dẫn!
</p>

<!-- Divider -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;">
  <tr><td style="border-top:1px solid #E5E7EB;"></td></tr>
</table>

<!-- Campaign info card -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;border:1px solid #E5E7EB;border-radius:12px;overflow:hidden;">
  <tr>
    <td style="background:linear-gradient(135deg,#DC2626 0%,#F97316 100%);padding:14px 20px;">
      <p style="margin:0;font-size:12px;font-weight:700;color:#FFFFFF;text-transform:uppercase;letter-spacing:1px;">&#9889; Thông tin chiến dịch</p>
    </td>
  </tr>
  <tr>
    <td style="padding:0;">
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <!-- Campaign name -->
        <tr>
          <td style="padding:16px 20px;border-bottom:1px solid #F3F4F6;width:40%;vertical-align:top;">
            <p style="margin:0;font-size:13px;color:#6B7280;font-weight:500;">Tên chiến dịch</p>
          </td>
          <td style="padding:16px 20px;border-bottom:1px solid #F3F4F6;vertical-align:top;">
            <p style="margin:0;font-size:14px;font-weight:700;color:#111827;"><%= campaignName %></p>
          </td>
        </tr>
        <!-- Start time -->
        <tr>
          <td style="padding:16px 20px;vertical-align:top;">
            <p style="margin:0;font-size:13px;color:#6B7280;font-weight:500;">Thời gian bắt đầu</p>
          </td>
          <td style="padding:16px 20px;vertical-align:top;">
            <p style="margin:0;font-size:14px;font-weight:600;color:#DC2626;"><%= campaignStartTime %></p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- Note about notification -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:28px;">
  <tr>
    <td style="background-color:#EFF6FF;border-radius:8px;padding:16px 20px;border-left:4px solid #3B82F6;">
      <p style="margin:0;font-size:14px;color:#1E40AF;line-height:1.6;">
        <strong>&#128276; Nhắc nhở tự động:</strong> Bạn sẽ nhận được email thông báo trước khi chiến dịch bắt đầu. Hãy chắc chắn rằng bạn đã đăng nhập và sẵn sàng để không bỏ lỡ!
      </p>
    </td>
  </tr>
</table>

<!-- Divider -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom:24px;">
  <tr><td style="border-top:1px solid #E5E7EB;"></td></tr>
</table>

<!-- Footer note -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
  <tr>
    <td style="background-color:#F9FAFB;border-radius:8px;padding:14px 20px;">
      <p style="margin:0;font-size:13px;color:#6B7280;line-height:1.6;">
        Nếu bạn muốn hủy đăng ký nhận thông báo, bạn có thể thực hiện trong phần cài đặt tài khoản trên trang web Flash Sale.
      </p>
    </td>
  </tr>
</table>

<%- include('_footer') %>
