    "@nestjs/testing": "10.0.0",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^1.0.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "4.17.17",
    "@types/ioredis": "5.0.0",
    "@types/jest": "29.5.2",
    "@types/joi": "^17.2.3",
    "@types/multer": "1.4.7",
    "@types/node": "20.3.1",
    "@types/node-polyglot": "^2.5.0",
    "@types/passport": "^1.0.12",
    "@types/passport-jwt": "^3.0.9",
    "@types/passport-local": "^1.0.35",
    "@types/supertest": "2.0.12",
