  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "pnpm build && pnpm prisma:migrate:deploy && node ./dist/src/main",
    "start:db:dev": "pnpm prisma:generate && pnpm prisma:migrate:dev",
    "dev:docker": "docker compose -f ./docker-compose.local.yml up -d --build",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate:reset": "prisma migrate reset --preview-feature",
    "prisma:migrate:dev": "prisma migrate dev --name autoMigrate --preview-feature",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:resolve": "prisma migrate resolve --applied",
    "prisma:db": "npx prisma db push --preview-feature",
    "prisma:studio": "prisma studio",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "seed:plans": "ts-node prisma/seed-subscription-plans.ts",
    "migrate:users": "ts-node prisma/migrations/migrate-users-from-old-db.ts",
    "migrate:users:test": "ts-node prisma/migrations/test-migration.ts",
    "migrate:users:quick": "bash prisma/migrations/quick-migrate-users.sh",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs}/**/*.ts\" --max-warnings=0",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepush:check": "pnpm lint:check && pnpm format:check && pnpm build",
    "e2e": "cross-env NODE_ENV=${NODE_ENV:=test} jest --config=test/jest.config.json",
    "commit": "cz",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release": "semantic-release",
    "postinstall": "cd .. && husky install flashsale-backend/.husky",
    "test:unit": "jest --selectProjects unit --coverage --detectOpenHandles --verbose",
    "test:e2e": "jest --selectProjects e2e --detectOpenHandles --verbose",
    "test": "jest --coverage --detectOpenHandles --verbose",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:pull": "npx prisma db pull"
  },
