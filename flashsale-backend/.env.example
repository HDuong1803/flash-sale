# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:pass@localhost:5432/flashsale
DIRECT_DATABASE_URL=postgresql://user:pass@localhost:5432/flashsale

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URL=amqp://user:pass@localhost:5672

# JWT
JWT_SECRET_KEY=your-access-token-secret-min-32-chars
JWT_EXPIRE_TIME=15m
JWT_REFRESH_PRIVATE_KEY=your-refresh-token-secret-min-32-chars
JWT_EXPIRE_REFRESH_TIME=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bcrypt
BCRYPT_SALT=10

# Payment Gateways (optional — mock used if empty)
STRIPE_SECRET_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3001/payment/return
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# SePay Payment Gateway
# Đăng ký tại: my.dev.sepay.vn (sandbox) / my.sepay.vn (production)
SEPAY_API_KEY=your_sepay_api_key        # Dùng để verify webhook Authorization header
SEPAY_BANK_ACCOUNT=your_bank_account_no # Số tài khoản nhận tiền
SEPAY_BANK_CODE=MB                      # Mã ngân hàng (MB, VCB, TCB, ...)
SEPAY_ACCOUNT_NAME=YOUR_SHOP_NAME       # Tên hiển thị trên QR
SEPAY_SANDBOX=true                      # false khi production

# Cloudinary — Image Upload & CDN
# Đăng ký tại: cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (optional)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SENDER_EMAIL=noreply@yourdomain.com

# CORS & URLs
CLIENT_API_HOST=http://localhost:3000
CLIENT_URL=http://localhost:3001
SERVER_URL=http://localhost:3000

# Timeouts & TTLs (optional — defaults shown)
WEBHOOK_TIMEOUT_MS=30000           # Webhook saga timeout (ms)
SLOW_REQUEST_THRESHOLD_MS=1000     # Log warn threshold for slow requests (ms)
CHECKOUT_ADDRESS_TTL_SECONDS=1200  # Shipping address Redis TTL (seconds, 20min)
LONG_RUNNING_REQUEST_TIMEOUT_MS=60000  # Timeout for webhook/checkout requests (ms)
NORMAL_REQUEST_TIMEOUT_MS=30000    # Timeout for normal requests (ms)
