# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:pass@localhost:5432/flashsale
DIRECT_DATABASE_URL=postgresql://user:pass@localhost:5432/flashsale

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URL=amqp://user:pass@localhost:5672

# JWT
JWT_SECRET_KEY=your-access-token-secret-min-32-chars
JWT_EXPIRE_TIME=15m
JWT_REFRESH_PRIVATE_KEY=your-refresh-token-secret-min-32-chars
JWT_EXPIRE_REFRESH_TIME=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bcrypt
BCRYPT_SALT=10

# Payment Gateways (optional — mock used if empty)
STRIPE_SECRET_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3001/payment/return
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# Email (optional)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SENDER_EMAIL=noreply@yourdomain.com
