#-------------------------------------------------
# General
NODE_ENV=development

# 5686
PORT=

# 10 
BCRYPT_SALT=10

# Docker Network
NETWORK=

CLIENT_URL_SERVER=
BACKEND_URL_SERVER=
CLIENT_URL_LOCAL=
BACKEND_URL_LOCAL=
# Set 'true' when NODE_ENV=development but deployed cross-site (e.g. staging on Vercel + separate API domain)
# Forces SameSite=None;Secure on auth cookies so browser sends them in cross-origin XHR
COOKIE_CROSS_SITE=false
RABBITMQ_URL=

# Timeouts & TTLs (optional — defaults shown)
WEBHOOK_TIMEOUT_MS=30000           # Webhook saga timeout (ms)
SLOW_REQUEST_THRESHOLD_MS=1000     # Log warn threshold for slow requests (ms)
CHECKOUT_ADDRESS_TTL_SECONDS=1200  # Shipping address Redis TTL (seconds, 20min)
LONG_RUNNING_REQUEST_TIMEOUT_MS=60000  # Timeout for webhook/checkout requests (ms)
NORMAL_REQUEST_TIMEOUT_MS=30000    # Timeout for normal requests (ms)

#-------------------------------------------------
# Database
# depending on which database you are using the credentials might be different
# postgresql://<DB_USERNAME>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=

#---------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_EXPIRATION=300

#---------------------------------------------------
# Jwt options
JWT_PRIVATE_KEY=
JWT_REFRESH_PRIVATE_KEY=
JWT_PUBLIC_KEY=
#HS256
JWT_ALGORITHM=HS256
# 900
JWT_EXPIRE_TIME=86400
# 86400
JWT_EXPIRE_REFRESH_TIME=432000

SESSION_SECRET=
DIRECT_DATABASE_URL=

# Email Provider Configuration
EMAIL_PROVIDER=

# Email Settings
EMAIL_SUPPORT=

RESEND_API_KEY=

SENDER_EMAIL=

JWT_SECRET_KEY=

# Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_api_secret

# ─── Sentry Error Tracking ───────────────────────────────────────────────────
# Lấy DSN từ: Sentry Dashboard → Settings → Projects → <project> → Client Keys
# Để trống khi chạy local (Sentry tự động tắt nếu không có DSN)
SENTRY_DSN=
# Tên release — CI/CD nên set: git rev-parse --short HEAD
SENTRY_RELEASE=
# Webhook URL để gửi alert (Slack, Discord, ...)
SENTRY_WEBHOOK_URL=

# Cloudinary — Image Upload & CDN
# Đăng ký tại: cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional)
EMAIL_PROVIDER=
RESEND_API_KEY=
SENDER_EMAIL=

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=


# Timeouts & TTLs (optional — defaults shown)
WEBHOOK_TIMEOUT_MS=30000           # Webhook saga timeout (ms)
SLOW_REQUEST_THRESHOLD_MS=1000     # Log warn threshold for slow requests (ms)
CHECKOUT_ADDRESS_TTL_SECONDS=1200  # Shipping address Redis TTL (seconds, 20min)
LONG_RUNNING_REQUEST_TIMEOUT_MS=60000  # Timeout for webhook/checkout requests (ms)
NORMAL_REQUEST_TIMEOUT_MS=30000    # Timeout for normal requests (ms)

# Analytics Snapshot Retention (optional)
ANALYTICS_SNAPSHOT_CLEANUP_ENABLED=true
ANALYTICS_SNAPSHOT_RETENTION_DAYS=30
ANALYTICS_SNAPSHOT_CLEANUP_BATCH_SIZE=5000
ANALYTICS_SNAPSHOT_CLEANUP_MAX_BATCHES=24

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Country for Stripe Express connected accounts.
# Set 'US' for demo/test (full capabilities). Default: VN (production).
STRIPE_CONNECT_COUNTRY=US

# GHN (Giao Hàng Nhanh) Shipping
# Đăng ký tại https://sso.ghn.vn/ để lấy sandbox credentials
# Sandbox URL: https://dev-online-gateway.ghn.vn/shiip/public-api
# Production URL: https://online-gateway.ghn.vn/shiip/public-api
GHN_API_KEY=
GHN_SHOP_ID=
GHN_SANDBOX=true
GHN_WEBHOOK_TOKEN=
# ID quận/huyện của kho hàng (1482 = Quận Bắc Từ Liêm, Hà Nội)
GHN_FROM_DISTRICT_ID=1482
# Mã phường của kho hàng ("11004" = Phường Đức Thắng, Quận Bắc Từ Liêm, Hà Nội) — dùng để tính phí chính xác hơn
GHN_FROM_WARD_CODE=11004
